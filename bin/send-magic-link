#!/bin/sh
# Magic-link mailer for memory-engine-api, invoked via
# MEMORY_ENGINE_AUTH_MAILER_COMMAND. The API execs this with no arguments and
# the contract env vars MEMORY_ENGINE_AUTH_EMAIL / MEMORY_ENGINE_AUTH_LINK
# (a relative path). Sends through Resend.
#
# Inputs are trusted by construction: the API only delivers links for
# allowlisted emails, and the link token is server-generated alphanumeric —
# so plain interpolation into the JSON body is safe here.
#
# RESEND_API_URL is overridable for tests only.
set -eu
: "${RESEND_API_KEY:?RESEND_API_KEY is required}"
: "${MEMORY_ENGINE_AUTH_EMAIL:?MEMORY_ENGINE_AUTH_EMAIL is required}"
: "${MEMORY_ENGINE_AUTH_LINK:?MEMORY_ENGINE_AUTH_LINK is required}"

base="${MEMORY_ENGINE_PUBLIC_BASE_URL:-https://memory-engine-api-i2xcr.ondigitalocean.app}"
api="${RESEND_API_URL:-https://api.resend.com}"
sign_in_url="${base}${MEMORY_ENGINE_AUTH_LINK}"

# Sender. Defaults to onboarding@resend.dev, which Resend delivers only to the
# account owner (the solo-dogfood allowlist) and which Gmail spam-folders for
# want of domain reputation. After verifying a domain in Resend, set
# MEMORY_ENGINE_MAIL_FROM (an encrypted App Platform variable) to a sender on
# that domain — no edit or redeploy of this script. See docs/runbook.md,
# "Deliverability". Use a plain
# display name with no literal double-quote — the value is interpolated into the
# JSON body unescaped (trusted operator config, like the rest of this script).
from="${MEMORY_ENGINE_MAIL_FROM:-Memory Engine <onboarding@resend.dev>}"

curl -sf --max-time 10 "$api/emails" \
    -H "Authorization: Bearer $RESEND_API_KEY" \
    -H "Content-Type: application/json" \
    -d "{\"from\":\"$from\",\"to\":[\"$MEMORY_ENGINE_AUTH_EMAIL\"],\"subject\":\"Your Memory Engine sign-in link\",\"text\":\"Sign in: $sign_in_url\\n\\nThe link expires shortly. If you did not request it, ignore this email.\"}" \
    > /dev/null
