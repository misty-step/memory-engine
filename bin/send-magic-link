#!/bin/sh
# Magic-link mailer for memory-engine-api, invoked via
# MEMORY_ENGINE_AUTH_MAILER_COMMAND. The API execs this with no arguments and
# the contract env vars MEMORY_ENGINE_AUTH_EMAIL / MEMORY_ENGINE_AUTH_LINK
# (a relative path). Sends through Resend.
#
# RESEND_API_URL is overridable for tests only.
#
# Diagnostics are deliberately bounded: only the provider acceptance state and
# provider-generated email id are written to stderr. Recipient, token, link,
# response body, and message content never enter diagnostics.
set -eu
: "${RESEND_API_KEY:?RESEND_API_KEY is required}"

base="${MEMORY_ENGINE_PUBLIC_BASE_URL:-https://memory-engine-api-i2xcr.ondigitalocean.app}"
api="${RESEND_API_URL:-https://api.resend.com}"

json_lf=$(printf '\nx')
json_lf=${json_lf%x}
json_cr=$(printf '\rx')
json_cr=${json_cr%x}
json_tab=$(printf '\tx')
json_tab=${json_tab%x}
json_bs=$(printf '\\')

reject_controls() {
    value=$1
    if [ "$(printf '%s' "$value" | wc -l)" -gt 0 ] || printf '%s' "$value" | LC_ALL=C grep -q '[[:cntrl:]]'; then
        echo 'mailer input contains unsupported control characters' >&2
        return 1
    fi
}

json_escape() {
    value=$1
    if printf '%s' "$value" | tr -d "${json_lf}${json_cr}${json_tab}" | LC_ALL=C grep -q '[[:cntrl:]]'; then
        echo 'mailer input contains unsupported control characters' >&2
        return 1
    fi
    escaped=
    while [ -n "$value" ]; do
        char=${value%"${value#?}"}
        value=${value#?}
        case "$char" in
            "$json_bs") escaped="${escaped}\\\\" ;;
            '"') escaped="${escaped}\\\"" ;;
            "$json_lf") escaped="${escaped}\n" ;;
            "$json_cr") escaped="${escaped}\r" ;;
            "$json_tab") escaped="${escaped}\t" ;;
            *) escaped="${escaped}${char}" ;;
        esac
    done
    printf '%s' "$escaped"
}

json_escape_untrusted() {
    reject_controls "$1" || return 1
    json_escape "$1"
}

send_email() {
    email=$1
    subject=$2
    text=$3
    idempotency_key=$4
    from="${MEMORY_ENGINE_MAIL_FROM:-Scry <onboarding@resend.dev>}"

    email_json=$(json_escape_untrusted "$email") || return 1
    from_json=$(json_escape_untrusted "$from") || return 1
    subject_json=$(json_escape_untrusted "$subject") || return 1
    text_json=$(json_escape "$text") || return 1
    payload=$(printf '{"from":"%s","to":["%s"],"subject":"%s","text":"%s"}' \
        "$from_json" "$email_json" "$subject_json" "$text_json")

    if [ -n "$idempotency_key" ]; then
        reject_controls "$idempotency_key" || return 1
    fi

    response_file=$(mktemp) || return 1
    trap 'rm -f "$response_file"' 0 1 2 3 15
    if [ -n "$idempotency_key" ]; then
        if ! http_status=$(curl -sS --max-time 10 -o "$response_file" -w '%{http_code}' "$api/emails" \
            -H "Authorization: Bearer $RESEND_API_KEY" \
            -H 'Content-Type: application/json' \
            -H "Idempotency-Key: $idempotency_key" \
            -d "$payload" 2>/dev/null); then
            echo 'resend_status=transport_error' >&2
            return 1
        fi
    elif ! http_status=$(curl -sS --max-time 10 -o "$response_file" -w '%{http_code}' "$api/emails" \
        -H "Authorization: Bearer $RESEND_API_KEY" \
        -H 'Content-Type: application/json' \
        -d "$payload" 2>/dev/null); then
        echo 'resend_status=transport_error' >&2
        return 1
    fi

    case "$http_status" in
        2??)
            provider_id=$(sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9._-]*\)".*/\1/p' "$response_file" | head -n 1 | cut -c1-128)
            [ -n "$provider_id" ] || provider_id=unknown
            printf 'resend_status=accepted resend_id=%s\n' "$provider_id" >&2
            ;;
        *)
            printf 'resend_status=failed http_status=%s\n' "$http_status" >&2
            return 1
            ;;
    esac
}

if [ -n "${MEMORY_ENGINE_RETURN_NOTIFICATION_EMAIL:-}" ]; then
    : "${MEMORY_ENGINE_RETURN_NOTIFICATION_DUE_COUNT:?MEMORY_ENGINE_RETURN_NOTIFICATION_DUE_COUNT is required}"
    : "${MEMORY_ENGINE_RETURN_NOTIFICATION_UNSUBSCRIBE:?MEMORY_ENGINE_RETURN_NOTIFICATION_UNSUBSCRIBE is required}"
    : "${MEMORY_ENGINE_RETURN_NOTIFICATION_IDEMPOTENCY_KEY:?MEMORY_ENGINE_RETURN_NOTIFICATION_IDEMPOTENCY_KEY is required}"
    email="$MEMORY_ENGINE_RETURN_NOTIFICATION_EMAIL"
    due_count="$MEMORY_ENGINE_RETURN_NOTIFICATION_DUE_COUNT"
    unsubscribe_url="${base}${MEMORY_ENGINE_RETURN_NOTIFICATION_UNSUBSCRIBE}"
    subject="You have ${due_count} Scry review"
    [ "$due_count" = "1" ] || subject="You have ${due_count} Scry reviews"
    text=$(printf 'You have %s review(s) waiting in Scry. Return when it suits you: %s/\n\nTo turn off these reminders, visit: %s' "$due_count" "$base" "$unsubscribe_url")
    send_email "$email" "$subject" "$text" "$MEMORY_ENGINE_RETURN_NOTIFICATION_IDEMPOTENCY_KEY"
    exit 0
fi

: "${MEMORY_ENGINE_AUTH_EMAIL:?MEMORY_ENGINE_AUTH_EMAIL is required}"
: "${MEMORY_ENGINE_AUTH_LINK:?MEMORY_ENGINE_AUTH_LINK is required}"
sign_in_url="${base}${MEMORY_ENGINE_AUTH_LINK}"
text=$(printf 'Sign in: %s\n\nThe link expires shortly. If you did not request it, ignore this email.' "$sign_in_url")
send_email "$MEMORY_ENGINE_AUTH_EMAIL" 'Your Scry sign-in link' "$text" ''
