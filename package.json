{
  "name": "memory-engine",
  "version": "0.0.0",
  "description": "Rust learning engine kernel and local beta study applications.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "cargo test --workspace",
    "bench": "cargo run -p memory-engine-bench",
    "qa": "cargo run -p memory-engine-qa -- --full",
    "qa:local": "cargo run -p memory-engine-qa -- --local",
    "rust:fmt": "cargo fmt --all --check",
    "rust:test": "cargo test --workspace",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:doc": "cargo doc --workspace --no-deps",
    "rust:beta-study": "cargo run -p memory-engine-beta-app",
    "rust:cli-review": "cargo run -p memory-engine-cli",
    "rust:import-probe": "cargo run -p memory-engine-import",
    "rust:web-shell": "cargo run -p memory-engine-web-shell",
    "rust:web-shell:receipt": "cargo run -p memory-engine-web-shell -- --receipt",
    "rust:dogfood": "cargo run -p memory-engine-cli && cargo run -p memory-engine-import && cargo run -p memory-engine-web-shell -- --receipt",
    "rust:ci": "cargo fmt --all --check && cargo test --workspace && cargo clippy --workspace --all-targets -- -D warnings && cargo doc --workspace --no-deps",
    "ci:fast": "bun run rust:ci",
    "ci:local": "bun run ci:fast",
    "ci:full": "dagger call check --source=.",
    "ci": "bun run ci:fast"
  }
}
