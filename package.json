{
  "name": "memory-engine",
  "version": "0.0.0",
  "description": "Shared learning engine kernel: canonical types, FSRS reference scheduler, deterministic grading.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./grading": "./src/grading.ts",
    "./progression": "./src/progression-api.ts",
    "./queue": "./src/queue-api.ts",
    "./scheduling": "./src/scheduling.ts",
    "./testkit": "./testkit/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "bench": "cargo run -p memory-engine-bench",
    "experiments:cli-review": "bun run rust:cli-review",
    "experiments:cli-review:ts-oracle": "bun run experiments/cli-review/index.ts",
    "experiments:import-probe": "bun run rust:import-probe",
    "experiments:import-probe:ts-oracle": "bun run experiments/import-probe/index.ts",
    "experiments:web-shell": "bun run rust:web-shell",
    "experiments:web-shell:receipt": "bun run rust:web-shell:receipt",
    "experiments:web-shell:ts-oracle": "bun run experiments/web-shell/server.ts",
    "coverage": "bun run scripts/check-coverage.ts",
    "qa": "bun run scripts/qa.ts --full",
    "qa:local": "bun run scripts/qa.ts --local",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "rust:fmt": "cargo fmt --all --check",
    "rust:test": "cargo test --workspace",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:doc": "cargo doc --workspace --no-deps",
    "rust:beta-study": "cargo run -p memory-engine-beta-app",
    "rust:cli-review": "cargo run -p memory-engine-cli",
    "rust:import-probe": "cargo run -p memory-engine-import",
    "rust:web-shell": "cargo run -p memory-engine-web-shell",
    "rust:web-shell:receipt": "cargo run -p memory-engine-web-shell -- --receipt",
    "rust:dogfood": "bun run rust:cli-review && bun run rust:import-probe && bun run rust:web-shell:receipt",
    "rust:ci": "bun run rust:fmt && bun run rust:test && bun run rust:clippy && bun run rust:doc",
    "ci:local": "bun run typecheck && bun run check && bun run coverage && bun run rust:ci",
    "ci": "dagger call check --source=."
  },
  "dependencies": {
    "ts-fsrs": "5.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "bun-types": "^1.3.11",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
